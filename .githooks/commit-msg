#!/usr/bin/env bash
# COMMIT_RULES.md 2절 커밋 메시지 형식을 강제한다.
#   <type>(<scope>): <subject>
# type   : feat | fix | docs | test | refactor | chore
# scope  : 선택. COMMIT_RULES.md 2절 scope 목록 중 하나 (노션 작업 트래커 scope와 동일)
# subject: 한글 포함, 마침표 없이

set -euo pipefail

msg_file="$1"
subject_line="$(head -n 1 "$msg_file" | tr -d '\r')"

# git이 만드는 merge / revert / fixup / squash 커밋은 통과
if [[ "$subject_line" =~ ^Merge\  ]] || [[ "$subject_line" =~ ^Revert\  ]] \
   || [[ "$subject_line" =~ ^(fixup|squash|amend)\! ]]; then
  exit 0
fi

type_re='feat|fix|docs|test|refactor|chore'
scope_re='interfaces|manager|arm|agv|palletizer|fake|bringup|unity-arm|unity-line|unity-agv|unity-ui|unity-ros|scene|test|chore|design|milestone|docs'

fail() {
  echo "" >&2
  echo "✖ commit-msg 훅: 커밋 메시지가 규칙과 다릅니다." >&2
  echo "  받은 메시지 : $subject_line" >&2
  echo "  이유        : $1" >&2
  echo "" >&2
  echo "  형식  : <type>(<scope>): <subject>   (COMMIT_RULES.md 참고)" >&2
  echo "  type  : feat | fix | docs | test | refactor | chore" >&2
  echo "  scope : ${scope_re//|/ | }" >&2
  echo "  subject: 한글로, 끝에 마침표 없이" >&2
  echo "" >&2
  echo "  예) feat(manager): FSM 상태 전이 추가" >&2
  echo "  예) fix(unity-line): 대기 칸 end_wait 중복 발행 수정" >&2
  echo "  예) docs: 설치 가이드 VirtualBox 포트포워딩 추가" >&2
  echo "" >&2
  exit 1
}

if [[ ! "$subject_line" =~ ^(${type_re})(\(([a-z0-9-]+)\))?:\ (.+)$ ]]; then
  fail "'<type>(<scope>): <subject>' 형식이 아닙니다 (콜론 뒤 공백 1칸, scope는 영문 소문자)."
fi

scope="${BASH_REMATCH[3]:-}"
subject="${BASH_REMATCH[4]}"

if [[ -n "$scope" ]] && [[ ! "$scope" =~ ^(${scope_re})$ ]]; then
  fail "scope '$scope'는 목록에 없습니다."
fi

if [[ "$subject" =~ \.$ ]]; then
  fail "subject 끝에 마침표를 붙이지 않습니다."
fi

# 한글 포함 여부: UTF-8 한글 음절(U+AC00~U+D7A3)의 첫 바이트는 0xEA~0xED.
# grep -P 없이 Git Bash(Windows)와 Ubuntu에서 똑같이 동작하도록 바이트로 검사한다.
if ! printf '%s' "$subject" | LC_ALL=C grep -q $'[\xea-\xed]'; then
  fail "subject는 한글로 작성합니다."
fi

if (( ${#subject_line} > 72 )); then
  echo "⚠ commit-msg 훅 경고: 제목이 72자를 넘습니다. 자세한 내용은 본문(빈 줄 다음)에 쓰세요." >&2
fi

exit 0
